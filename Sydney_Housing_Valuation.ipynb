   "source": [
    "np.random.seed(7)\n",
    "parts = []\n",
    "for sub, g in test_df.groupby('Suburb'):\n",
    "    n = 4 if sub!='Blacktown' else 2\n",
    "    parts.append(g.sample(n=min(n,len(g)), random_state=7))\n",
    "sel = pd.concat(parts)\n",
    "if len(sel) > 10:\n",
    "    sel = sel.sample(n=10, random_state=7)\n",
    "\n",
    "X_sel = sel[num_features+cat_features]\n",
    "sel['ML_Pred'] = np.exp(best_pipe.predict(X_sel))\n",
    "\n",
    "train_df = df.loc[idx_train].copy()\n",
    "train_df['PricePerSqmBldg'] = train_df['SalePrice']/train_df['BuildingArea'].replace(0,np.nan)\n",
    "rates = train_df.groupby(['Suburb','PropertyType'])['PricePerSqmBldg'].median()\n",
    "rates_d = rates.to_dict()\n",
    "sel['HumanEst'] = sel.apply(lambda r: r['BuildingArea']*rates_d.get((r['Suburb'],r['PropertyType']), np.nan), axis=1).round(-3)\n",
    "\n",
    "# Independent LLM valuations (reasoned manually from features/description; see report Part 5)\n",
    "llm_estimates = {\n",
    "    'BLK_008': 1050000, 'BLK_006': 950000, 'MRK_035': 650000, 'MRK_007': 1900000, 'MRK_010': 2000000,\n",
    "    'MRK_033': 700000, 'MOS_013': 3800000, 'MOS_019': 2600000, 'MOS_031': 850000, 'MOS_011': 5200000,\n",
    "}\n",
    "sel['LLM_Pred'] = sel['PropertyID'].map(llm_estimates)\n",
    "\n",
    "for col, name in [('ML_Pred','ML_Error'), ('LLM_Pred','LLM_Error'), ('HumanEst','Human_Error')]:\n",
    "    sel[name] = ((sel[col]-sel['SalePrice']).abs()/sel['SalePrice'])*100\n",
    "\n",
    "sel[['PropertyID','Suburb','SalePrice','ML_Pred','ML_Error','LLM_Pred','LLM_Error','HumanEst','Human_Error']].round(1)\n"
   ]
  },
