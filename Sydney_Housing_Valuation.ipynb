   "source": [
    "outliers = []\n",
    "for sub, g in df_raw.groupby('Suburb'):\n",
    "    q1, q3 = g['SalePrice'].quantile([0.25,0.75])\n",
    "    iqr = q3-q1\n",
    "    lo, hi = q1-1.5*iqr, q3+1.5*iqr\n",
    "    out = g[(g['SalePrice']<lo)|(g['SalePrice']>hi)]\n",
    "    outliers.append(out)\n",
    "    print(sub, 'n_outliers=', len(out))\n",
    "pd.concat(outliers)[['PropertyID','Suburb','PropertyType','SalePrice']]\n"
   ]
  },
